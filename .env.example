# ── Chung ──
NODE_ENV=development

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_ORGANIZATION_ID=org_demo
NEXT_PUBLIC_DEMO_USER_ID=user_demo_admin
NEXT_PUBLIC_DEMO_USER_ROLE=ORG_ADMIN

# ── API (NestJS) ──
API_PORT=3001

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seeding_strategy

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT (sẽ dùng ở T09) ──
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Provider (sẽ dùng ở T33) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_RPM=60
AI_RATE_LIMIT_CONCURRENT=10
AI_BATCH_SIZE=10
AI_BATCH_DELAY_MS=200

# ── Storage (sẽ dùng ở T22) ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_RETENTION_DAYS=90
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Backup (production) ──
DB_BACKUP_ENABLED=false
DB_BACKUP_CRON=0 2 * * *

# ── Logging ──
LOG_LEVEL=info

# Google Places — hỗ trợ nhập hồ sơ doanh nghiệp ở Module 1
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_MS=5000
GOOGLE_PLACES_LANGUAGE_CODE=vi
GOOGLE_PLACES_REGION_CODE=VN
GOOGLE_PLACES_AUTOCOMPLETE_MONTHLY_LIMIT=8000
GOOGLE_PLACES_AUTOCOMPLETE_ORG_MONTHLY_LIMIT=200
GOOGLE_PLACES_MONTHLY_LIMIT=800
GOOGLE_PLACES_ORG_MONTHLY_LIMIT=20
