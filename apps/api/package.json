{
  "name": "@seeding/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:business": "vitest run src/modules/businesses",
    "typecheck": "tsc --noEmit",
    "db:migrate": "pnpm --filter @seeding/database exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @seeding/database exec prisma migrate deploy",
    "db:push": "pnpm --filter @seeding/database exec prisma db push",
    "db:seed": "pnpm --filter @seeding/database exec node --import tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @seeding/database exec prisma studio",
    "prisma:generate": "pnpm --filter @seeding/database exec prisma generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.4.6",
    "@seeding/ai-core": "workspace:*",
    "@seeding/contracts": "workspace:*",
    "@seeding/database": "workspace:*",
    "@seeding/serpapi-client": "workspace:*",
    "@seeding/validation": "workspace:*",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.1",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@seeding/eslint-config": "workspace:*",
    "@seeding/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.31.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
